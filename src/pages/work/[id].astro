---
/**
 * Página dinámica de detalle por trabajo.
 * Genera 1 HTML estático por cada trabajo de la colección.
 * URL: /work/<slug>/
 */
import { render } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Gallery from '@components/Gallery.astro';
import ProjectCTA from '@components/ProjectCTA.astro';
import {
  getAllTrabajos,
  resolveVideo,
  CATEGORY_LABELS,
  CATEGORY_SLUGS,
} from '@lib/trabajos';
import { SITE } from '@/consts';
import { cldImageUrl, cldVideoUrl, cldVideoPoster } from '@lib/cloudinary';
import { contactLinks } from '@lib/contacto';

const base = (Astro.site ?? new URL(SITE.url)).origin;

export async function getStaticPaths() {
  const trabajos = await getAllTrabajos();
  return trabajos.map((w) => ({
    params: { id: w.id },
    props: { work: w },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const video = resolveVideo(work.data);
const hasVideo = Boolean(video.src);

const pageTitle = `${work.data.client} — Code Studio`;
// Description rica: tagline + tipo + cliente + año + ubicación.
// Sale entre 130-160 chars, mejor SEO que el tagline solo.
const pageDescription = [
  work.data.tagline,
  `${work.data.type.toLowerCase()} para ${work.data.client} (${work.data.year}).`,
  `Producción Code Studio en ${work.data.location}.`,
]
  .filter(Boolean)
  .join(' ')
  .slice(0, 160);

// Material extra (fotos + videos) que vive en Cloudinary.
const photos = work.data.photos
  .map((src) => ({
    thumb: cldImageUrl(src, { width: 900, crop: 'limit' }),
    full: cldImageUrl(src, { width: 2400, crop: 'limit' }),
    caption: '',
  }))
  .filter((p) => p.thumb && p.full);
const extraVideos = work.data.videos
  .map((v) => ({
    src: cldVideoUrl(v.src),
    poster: cldVideoPoster(v.src, 900),
    caption: v.caption ?? '',
  }))
  .filter((v) => v.src);

const contacto = contactLinks(work.data.client);

const categorySlug = CATEGORY_SLUGS[work.data.category];
const categoryLabel = CATEGORY_LABELS[work.data.category];

const videoJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: `${work.data.client} — ${work.data.type}`,
  description: work.body ?? '',
  thumbnailUrl: video.poster.startsWith('http') ? video.poster : `${base}${video.poster}`,
  uploadDate: `${work.data.year}-01-01`,
  contentUrl: video.src.startsWith('http') ? video.src : `${base}${video.src}`,
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: `${base}/logo.png`,
  },
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogType="article"
  jsonLd={hasVideo ? videoJsonLd : undefined}
>
  <Header />

  <div class="back-bar">
    <a href={`/${categorySlug}`}>← Volver a {categoryLabel}</a>
  </div>

  <section class="work-hero">
    <div class="work-meta">
      <span class="work-cat">{categoryLabel}</span>
      <span class="work-year">{work.data.year}</span>
      <span class="work-loc">{work.data.location}</span>
    </div>
    <h1 class="work-title">
      <span class="type">{work.data.type}</span>
      <span class="client">{work.data.client}</span>
    </h1>
    {work.data.tagline && <p class="work-tagline">"{work.data.tagline}"</p>}
    {
      hasVideo && (
        <div class="video-wrap">
          <video controls preload="metadata" playsinline poster={video.poster}>
            <source src={video.src} type="video/mp4" />
          </video>
          {/* Al terminar el video: contacto rápido en lugar de pantalla negra. */}
          <div class="video-end" hidden>
            <p class="video-end-title">¿Te gustó? Hagamos el tuyo.</p>
            <div class="video-end-actions">
              {contacto.whatsapp && (
                <a class="btn-cta primary" href={contacto.whatsapp} target="_blank" rel="noopener">
                  WhatsApp
                </a>
              )}
              <a class:list={['btn-cta', { primary: !contacto.whatsapp }]} href={contacto.mail}>
                Escribinos
              </a>
              <button class="btn-cta video-replay" type="button">↺ Ver de nuevo</button>
            </div>
          </div>
        </div>
      )
    }
  </section>

  <section class="work-body">
    <div class="work-desc">
      <Content />
    </div>

    <aside class="sidebar">
      {
        work.data.stats.length > 0 && (
          <div class="stats">
            {work.data.stats.map((s) => (
              <div class="stat-card">
                <div class="v">{s.value}</div>
                <div class="k">{s.label}</div>
              </div>
            ))}
          </div>
        )
      }

      {
        work.data.credits.length > 0 && (
          <div class="credits">
            <h4>Créditos</h4>
            <div class="credits-list">
              {work.data.credits.map((c) => (
                <div class="credit-row">
                  <span class="k">{c.role}</span>
                  <span class="v">{c.name}</span>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </aside>
  </section>

  {
    extraVideos.length > 0 && (
      <section class="media">
        <h2>Más videos</h2>
        <div class="media-videos">
          {extraVideos.map((v) => (
            <figure>
              <video controls preload="none" playsinline poster={v.poster ?? undefined}>
                <source src={v.src!} type="video/mp4" />
              </video>
              {v.caption && <figcaption>{v.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )
  }

  {
    photos.length > 0 && (
      <section class="media">
        <h2>Fotos</h2>
        <div class="media-photos">
          {photos.map((p, i) => (
            <a href={p.full!} class="photo" data-index={i}>
              <img src={p.thumb!} alt={p.caption || `${work.data.client} — foto ${i + 1}`} loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
        <dialog class="lightbox" aria-label="Foto ampliada">
          <img alt="" />
          <button class="lb-close" aria-label="Cerrar">×</button>
          <button class="lb-prev" aria-label="Foto anterior">‹</button>
          <button class="lb-next" aria-label="Foto siguiente">›</button>
        </dialog>
      </section>
    )
  }

  <ProjectCTA client={work.data.client} category={work.data.category} />

  <section class="related">
    <h2>Otros trabajos</h2>
    <Gallery filter="all" limit={3} />
  </section>

  <Footer />
</Layout>

<script>
  // Fin del video principal: muestra el contacto rápido. Se oculta al volver
  // a reproducir (botón "Ver de nuevo" o los controles del video).
  const mainVideo = document.querySelector<HTMLVideoElement>('.video-wrap video');
  const videoEnd = document.querySelector<HTMLElement>('.video-end');
  if (mainVideo && videoEnd) {
    mainVideo.addEventListener('ended', () => {
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      videoEnd.hidden = false;
    });
    mainVideo.addEventListener('play', () => (videoEnd.hidden = true));
    videoEnd.querySelector('.video-replay')?.addEventListener('click', () => {
      mainVideo.currentTime = 0;
      mainVideo.play().catch(() => {});
    });
  }

  // Lightbox simple: sin JS los links abren la foto grande en la misma pestaña.
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.media-photos .photo'));
  if (dialog && links.length) {
    const img = dialog.querySelector('img')!;
    let current = 0;
    const show = (i: number) => {
      current = (i + links.length) % links.length;
      img.src = links[current]!.href;
      img.alt = links[current]!.querySelector('img')?.alt ?? '';
    };
    links.forEach((a, i) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      })
    );
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('.lb-next')!.addEventListener('click', () => show(current + 1));
    // Click en el fondo (fuera de la foto) cierra.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  }
</script>

<style>
  .media {
    position: relative;
    z-index: 1;
    max-width: 1480px;
    margin: 0 auto;
    padding: 40px 5vw 20px;
  }

  .media h2 {
    font-family: var(--ff-display);
    font-size: clamp(28px, 3.6vw, 48px);
    letter-spacing: 0.01em;
    margin-bottom: 28px;
    color: var(--black);
  }

  /* Masonry por columnas: mezcla bien fotos/reels verticales y horizontales. */
  .media-videos,
  .media-photos {
    columns: 3 320px;
    column-gap: 14px;
  }

  .media-videos figure,
  .media-photos .photo {
    display: block;
    break-inside: avoid;
    margin: 0 0 14px;
  }

  .media-videos video {
    display: block;
    width: 100%;
    height: auto;
    background: var(--black);
    border: 1px solid rgba(0, 0, 0, 0.15);
  }

  .media-videos figcaption {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--black);
    opacity: 0.7;
    padding-top: 8px;
  }

  .media-photos .photo {
    overflow: hidden;
    cursor: zoom-in;
  }

  .media-photos img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.6s var(--ease-out);
  }

  .media-photos .photo:hover img { transform: scale(1.03); }

  .lightbox {
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    padding: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.92);
  }

  .lightbox::backdrop { background: rgba(0, 0, 0, 0.6); }

  .lightbox img {
    position: absolute;
    inset: 0;
    margin: auto;
    max-width: 92vw;
    max-height: 88vh;
    object-fit: contain;
  }

  .lightbox button {
    position: absolute;
    background: none;
    border: 0;
    color: var(--milk);
    font-size: 44px;
    line-height: 1;
    padding: 12px 18px;
    cursor: pointer;
  }

  .lightbox button:hover { color: var(--light); }
  .lb-close { top: 10px; right: 10px; }
  .lb-prev { left: 6px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 6px; top: 50%; transform: translateY(-50%); }
</style>

<style>
  .back-bar {
    position: relative;
    z-index: 1;
    max-width: 1480px;
    margin: 0 auto;
    padding: 100px 5vw 0;
  }

  .back-bar a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    /* Negro para contraste WCAG sobre milk; el hover sí vuelve naranja */
    color: var(--black);
    transition: gap 0.3s, color 0.3s;
  }

  .back-bar a:hover { color: var(--light); }

  .back-bar a:hover { gap: 14px; }

  .work-hero {
    position: relative;
    z-index: 1;
    padding: 60px 5vw 0;
    max-width: 1480px;
    margin: 0 auto;
  }

  .work-meta {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .work-cat {
    display: inline-block;
    font-size: 10px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    /* Negro para contraste WCAG sobre milk */
    color: var(--black);
    font-weight: 500;
  }

  .work-year {
    font-size: 11px;
    color: var(--black);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .work-loc {
    font-size: 11px;
    color: var(--black);
    opacity: 0.55;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .work-title {
    font-family: var(--ff-display);
    font-size: clamp(48px, 9vw, 132px);
    line-height: 0.88;
    letter-spacing: 0.01em;
    margin-bottom: 6px;
    color: var(--black);
  }

  .work-title .type {
    display: block;
    font-family: var(--ff-body);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(12px, 1.1vw, 16px);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    /* Negro con opacidad para contraste WCAG */
    color: var(--black);
    opacity: 0.6;
    margin-bottom: 18px;
  }

  .work-title .client { display: block; }

  .work-tagline {
    font-style: italic;
    font-weight: 300;
    font-size: clamp(16px, 1.6vw, 22px);
    color: rgba(0, 0, 0, 0.55);
    max-width: 760px;
    margin: 18px 0 48px;
    line-height: 1.4;
  }

  .video-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--black);
    border: 1px solid rgba(0, 0, 0, 0.15);
  }

  .video-wrap video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .video-end {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(18px, 3vw, 32px);
    padding: 24px;
    text-align: center;
    background: rgba(0, 0, 0, 0.78);
    animation: videoEndIn 0.5s var(--ease-out);
  }

  .video-end[hidden] { display: none; }

  @keyframes videoEndIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .video-end-title {
    font-family: var(--ff-display);
    font-size: clamp(24px, 4vw, 56px);
    line-height: 1;
    color: var(--milk);
  }

  .video-end-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .video-end .btn-cta { min-height: 44px; padding: 0 22px; font-size: clamp(12px, 1vw, 15px); }

  .video-end .btn-cta.primary { background: var(--light); color: var(--black); }

  .video-end .video-replay { color: var(--milk); border-color: rgba(251, 249, 245, 0.5); }

  /* En celular el video mide ~210px de alto: todo más compacto. */
  @media (max-width: 600px) {
    .video-end { gap: 12px; padding: 12px; }
    .video-end-title { font-size: 20px; }
    .video-end-actions { gap: 8px; }
    .video-end .btn-cta { min-height: 36px; padding: 0 14px; font-size: 11px; letter-spacing: 0.14em; }
  }

  .work-body {
    position: relative;
    z-index: 1;
    max-width: 1480px;
    margin: 0 auto;
    padding: 80px 5vw 40px;
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(40px, 6vw, 100px);
  }

  .work-desc :global(p) {
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.65;
    color: var(--black);
    opacity: 0.78;
    letter-spacing: 0.005em;
    margin-bottom: 22px;
  }

  .work-desc :global(p:first-of-type::first-line) {
    font-weight: 600;
    /* Negro bold (contraste WCAG) en lugar de naranja chico */
    color: var(--black);
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .sidebar h4 {
    font-family: var(--ff-body);
    display: inline-block;
    align-self: flex-start;
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    /* Negro para contraste WCAG sobre milk */
    color: var(--black);
    font-weight: 500;
    margin-bottom: 18px;
  }

  .credit-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--hair);
    gap: 16px;
  }

  .credit-row .k {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    /* Negro para contraste WCAG sobre milk */
    color: var(--black);
    font-weight: 600;
  }

  .credit-row .v {
    font-size: 13px;
    color: var(--black);
    text-align: right;
    font-weight: 500;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .stat-card {
    padding: 22px 14px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    text-align: center;
    background: transparent;
  }

  .stat-card .v {
    font-family: var(--ff-display);
    font-size: clamp(28px, 3vw, 40px);
    color: var(--light);
    line-height: 1;
    margin-bottom: 6px;
  }

  .stat-card .k {
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--black);
    opacity: 0.55;
    font-weight: 500;
  }

  .related {
    position: relative;
    z-index: 1;
    max-width: 1480px;
    margin: 60px auto 0;
    padding: 0 5vw 100px;
  }

  .related h2 {
    font-family: var(--ff-display);
    font-size: clamp(28px, 3.6vw, 48px);
    letter-spacing: 0.01em;
    margin-bottom: 36px;
    color: var(--black);
  }

  .related :global(.card-grid) { padding: 0; }

  @media (max-width: 820px) {
    .work-hero { padding-top: 30px; }
    .work-body {
      grid-template-columns: 1fr;
      padding-top: 50px;
      gap: 50px;
    }
    .stat-card { padding: 14px 8px; }
  }
</style>
