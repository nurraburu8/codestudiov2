---
/**
 * Grid de trabajos. Filtra por categoría o muestra todos.
 * Lee de Astro Content Collections (src/content/trabajos/*.md).
 * Generada en build time (sin JS necesario para mostrar la grid).
 *
 * Tarjetas horizontales, dos por fila, con el texto sobre la imagen. En
 * desktop, al pasar el mouse se reproduce el clip corto del trabajo (si tiene).
 */
import {
  getTrabajosByCategory,
  getHighlightTrabajos,
  resolveCardImage,
  resolveHeroVideo,
  CATEGORY_LABELS,
  type TrabajoCategory,
} from '@lib/trabajos';

interface Props {
  filter?: TrabajoCategory | 'all' | 'highlight';
  limit?: number;
  /** Slug a dejar afuera (ej: el trabajo que se está viendo). */
  exclude?: string;
}

const { filter = 'all', limit, exclude } = Astro.props;

const allWorks = (
  filter === 'highlight' ? await getHighlightTrabajos() : await getTrabajosByCategory(filter)
).filter((w) => w.id !== exclude);
const works = limit ? allWorks.slice(0, limit) : allWorks;
---

<div class="card-grid">
  {
    works.map((w, idx) => {
      const image = resolveCardImage(w.data);
      const clip = w.data.video ? resolveHeroVideo(w.data).src : '';
      return (
        <a class="cd" href={`/work/${w.id}`}>
          <div class="cm">
            {image ? (
              <img
                src={image.src}
                srcset={image.srcset}
                sizes="(max-width: 820px) 100vw, 50vw"
                alt={w.data.client}
                loading={idx < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            ) : (
              <span class="cm-placeholder" aria-hidden="true">
                <img src="/logo.png" alt="" width="36" height="36" loading="lazy" />
              </span>
            )}
            {clip && (
              <video class="cm-clip" muted loop playsinline preload="none" data-src={clip} aria-hidden="true" />
            )}
          </div>
          <div class="cinf">
            <span class="ctype">{w.data.type}</span>
            <h3 class="cnm">{w.data.client}</h3>
            <span class="cmeta">
              {CATEGORY_LABELS[w.data.category]} · {w.data.year}
            </span>
          </div>
          <span class="carrow" aria-hidden="true">→</span>
        </a>
      );
    })
  }
</div>

<style>
  .card-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(10px, 1.2vw, 18px);
    padding: 0 3vw 60px;
    max-width: 1720px;
    margin: 0 auto;
  }

  .cd {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 6px;
    background: var(--black);
    color: var(--milk);
    isolation: isolate;
  }

  /* Con dos por fila, si la cantidad es impar la última tarjeta ocupa todo
     el ancho (más panorámica) en lugar de dejar un hueco. */
  .cd:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    aspect-ratio: 21 / 8;
  }

  /* ── Imagen / clip ─────────────────────────────────── */
  .cm {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cm img,
  .cm-clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out), opacity 0.5s ease;
  }

  /* El clip aparece encima de la imagen recién cuando está reproduciendo. */
  .cm-clip { opacity: 0; }
  .cd.playing .cm-clip { opacity: 1; }

  .cd:hover .cm img,
  .cd:hover .cm-clip { transform: scale(1.05); }

  /* Sin imagen: fondo oscuro con un toque naranja y el logo tenue. */
  .cm-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-bottom: 12%;
    background: radial-gradient(120% 90% at 20% 0%, #2a160b 0%, var(--black) 60%);
    transition: transform 1.1s var(--ease-out);
  }

  .cm .cm-placeholder img {
    position: static;
    width: 28%;
    height: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.08;
  }

  .cd:hover .cm-placeholder { transform: scale(1.05); }

  /* Degradé para que el texto se lea sobre cualquier imagen. */
  .cd::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.35) 38%, rgba(0, 0, 0, 0) 65%);
    transition: opacity 0.5s;
  }

  /* Línea naranja que crece abajo en el hover. */
  .cd::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 100%;
    background: var(--light);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
    z-index: 2;
  }

  .cd:hover::before,
  .cd:focus-visible::before { transform: scaleX(1); }

  /* ── Texto ─────────────────────────────────────────── */
  .cinf {
    position: absolute;
    left: clamp(18px, 2.4vw, 36px);
    right: clamp(56px, 6vw, 90px);
    bottom: clamp(16px, 2.2vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: transform 0.6s var(--ease-out);
  }

  .cd:hover .cinf { transform: translateY(-4px); }

  .ctype {
    font-size: clamp(9px, 0.75vw, 11px);
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--light);
  }

  .cnm {
    font-family: var(--ff-display);
    font-size: clamp(26px, 3vw, 52px);
    line-height: 0.95;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--milk);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .cmeta {
    font-size: clamp(10px, 0.8vw, 12px);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--milk);
    opacity: 0.7;
  }

  .carrow {
    position: absolute;
    right: clamp(18px, 2.4vw, 36px);
    bottom: clamp(16px, 2.2vw, 32px);
    width: clamp(36px, 3.2vw, 48px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 1.5px solid rgba(251, 249, 245, 0.55);
    border-radius: 50%;
    font-size: clamp(14px, 1.2vw, 18px);
    color: var(--milk);
    transition: background 0.35s, color 0.35s, border-color 0.35s, transform 0.5s var(--ease-out);
  }

  .cd:hover .carrow {
    background: var(--light);
    border-color: var(--light);
    color: var(--black);
    transform: translateX(4px);
  }

  @media (max-width: 820px) {
    .card-grid {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 0 16px 60px;
    }
    .cd:last-child:nth-child(odd) { aspect-ratio: 16 / 10; }
  }
</style>

<script>
  /**
   * Preview del clip al pasar el mouse (solo desktop con mouse). El video no se
   * descarga hasta el primer hover; si el clip no carga, queda la imagen.
   */
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canHover && !reduceMotion) {
    document.querySelectorAll<HTMLElement>('.card-grid .cd').forEach((card) => {
      const clip = card.querySelector<HTMLVideoElement>('.cm-clip');
      if (!clip) return;

      card.addEventListener('mouseenter', () => {
        if (!clip.src) clip.src = clip.dataset.src ?? '';
        clip.play().then(
          // Si el mouse ya se fue mientras cargaba, no lo mostramos.
          () => card.matches(':hover') ? card.classList.add('playing') : clip.pause(),
          () => {}
        );
      });

      card.addEventListener('mouseleave', () => {
        card.classList.remove('playing');
        clip.pause();
      });
    });
  }
</script>
