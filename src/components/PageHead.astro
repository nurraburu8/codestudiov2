---
/**
 * Header de páginas internas (shows, marcas, eventos):
 * título grande.
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="pg-head">
  <h1 class="pg-title">{title}</h1>
</div>

<style>
  .pg-head {
    position: relative;
    z-index: 1;
    padding: 110px 5vw 56px;
    text-align: center;
  }

  .pg-title {
    font-family: var(--ff-display);
    font-size: clamp(52px, 8.5vw, 108px);
    line-height: 0.9;
    color: var(--black);
  }
</style>
