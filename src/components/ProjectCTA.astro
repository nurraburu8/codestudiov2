---
/**
 * Llamado a la acción al final de la página de cada trabajo:
 * "¿Tenés un evento? Contanos qué necesitás" + WhatsApp / mail / formulario.
 */
import { contactLinks, CTA_TITULOS } from '@lib/contacto';
import type { TrabajoCategory } from '@lib/trabajos';

interface Props {
  client: string;
  category: TrabajoCategory;
}

const { client, category } = Astro.props;
const links = contactLinks(client);
---

<section class="project-cta" aria-labelledby="project-cta-title">
  <div class="inner">
    <h2 id="project-cta-title">{CTA_TITULOS[category]}</h2>
    <p>Contanos qué necesitás y armamos la propuesta.</p>
    <div class="actions">
      {
        links.whatsapp && (
          <a class="btn-cta primary" href={links.whatsapp} target="_blank" rel="noopener">
            WhatsApp <span class="arrow">→</span>
          </a>
        )
      }
      <a class:list={['btn-cta', { primary: !links.whatsapp }]} href={links.mail}>
        Escribinos un mail <span class="arrow">→</span>
      </a>
      <a class="btn-cta" href={links.form}>
        Formulario <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .project-cta {
    position: relative;
    z-index: 1;
    background: var(--black);
    color: var(--milk);
    margin-top: 40px;
  }

  .inner {
    max-width: 1480px;
    margin: 0 auto;
    padding: clamp(56px, 9vw, 110px) 5vw;
    text-align: center;
  }

  h2 {
    font-family: var(--ff-display);
    font-size: clamp(34px, 5vw, 72px);
    line-height: 1;
    letter-spacing: 0.01em;
    margin-bottom: 18px;
  }

  p {
    font-size: clamp(15px, 1.3vw, 19px);
    opacity: 0.75;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  /* La acción principal va rellena para que se distinga. */
  .btn-cta.primary {
    background: var(--light);
    color: var(--black);
  }

  .btn-cta.primary:hover {
    background: var(--milk);
    border-color: var(--milk);
  }

  @media (max-width: 560px) {
    .actions { flex-direction: column; align-items: stretch; }
  }
</style>
