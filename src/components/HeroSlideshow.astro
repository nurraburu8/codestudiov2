---
/**
 * Hero slideshow del home.
 * Lee los trabajos desde la colección y los renderiza como slides.
 */
import { getFeaturedTrabajos, resolveHeroVideo } from '@lib/trabajos';

const slides = (await getFeaturedTrabajos()).map((w) => ({
  entry: w,
  ...resolveHeroVideo(w.data),
}));
const slideMeta = slides.map((s) => ({
  id: s.entry.id,
  type: s.entry.data.type,
  client: s.entry.data.client,
}));
---

<section class="hero">
  <div
    class="slideshow"
    id="slideshow"
    role="link"
    aria-label="Ver detalle del trabajo destacado"
    tabindex="0"
  >
    {
      slides.map((s, i) => (
        <div class={`slide ${i === 0 ? 'active' : ''}`} data-id={s.entry.id}>
          {/* Sin `loop`: cada slide dura lo que dura su clip (avanza en `ended`).
              El <source media> elige el recorte vertical en celulares parados. */}
          <video
            muted
            playsinline
            preload={i === 0 ? 'auto' : 'none'}
            poster={s.poster}
          >
            {s.srcVertical && (
              <source src={s.srcVertical} type="video/mp4" media="(orientation: portrait)" />
            )}
            <source src={s.src} type="video/mp4" />
          </video>
        </div>
      ))
    }
  </div>

  <div class="bottom">
    <a class="work-title" id="workTitleLink" href="#">
      <span class="type" id="workType"></span>
      <span class="client" id="workClient"></span>
    </a>
    <div class="progress-bar">
      <div class="progress-fill" id="progressFill"></div>
    </div>
    <div class="bottom-row">
      <div class="slide-nav" id="slideNav">
        {
          slides.map((_, i) => (
            <button class={i === 0 ? 'active' : ''} data-index={i}>
              {i + 1}
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script define:vars={{ worksData: slideMeta }}>
  (function () {
    // Cada slide dura lo que dura su clip: avanza cuando el video termina.
    // Este tiempo solo se usa si el video no puede reproducirse (autoplay
    // bloqueado, modo ahorro de batería, error de red).
    const FALLBACK_DURATION = 8000;

    const hero = document.querySelector('.hero');
    const slides = Array.from(document.querySelectorAll('.slide'));
    const btns = Array.from(document.querySelectorAll('#slideNav button'));
    const titleType = document.getElementById('workType');
    const titleClient = document.getElementById('workClient');
    const titleLink = document.getElementById('workTitleLink');
    const progressFill = document.getElementById('progressFill');
    const slideshow = document.getElementById('slideshow');

    if (!slides.length || !titleType || !titleClient || !titleLink || !progressFill) return;

    let current = 0;
    let started = false;
    let fallbackTimer = null;
    let fallbackStart = 0;
    let progressRAF = null;
    // Se pausa cuando la pestaña no está visible o el hero salió de pantalla.
    let tabVisible = !document.hidden;
    let heroVisible = true;

    function getWork(id) {
      return worksData.find((w) => w.id === id) || { type: '', client: '', id };
    }

    function setSpans(el, text, startOffset) {
      el.innerHTML = '';
      if (!text) return;
      const words = String(text).split(' ');
      let i = startOffset || 0;
      words.forEach((word, wi) => {
        const wordSpan = document.createElement('span');
        wordSpan.className = 'word';
        for (const ch of word) {
          const s = document.createElement('span');
          s.className = 'char';
          s.textContent = ch;
          s.style.animationDelay = i * 28 + 'ms';
          wordSpan.appendChild(s);
          i++;
        }
        el.appendChild(wordSpan);
        if (wi < words.length - 1) {
          el.appendChild(document.createTextNode(' '));
          i++;
        }
      });
    }

    function renderTitle(work) {
      setSpans(titleType, work.type, 0);
      const offset = (work.type || '').length + 2;
      setSpans(titleClient, work.client || '', offset);
      titleLink.href = work.id ? `/work/${work.id}` : '#';
    }

    function videoOf(i) {
      return slides[i] ? slides[i].querySelector('video') : null;
    }

    function ensureVideoLoaded(v) {
      if (!v || v.preload === 'auto') return;
      v.preload = 'auto';
      try { v.load(); } catch (e) {}
    }

    // La barra sigue al video real (currentTime / duration); en modo
    // fallback, al reloj.
    function tickProgress() {
      cancelAnimationFrame(progressRAF);
      const step = () => {
        const v = videoOf(current);
        let pct = 0;
        if (fallbackTimer) {
          pct = ((performance.now() - fallbackStart) / FALLBACK_DURATION) * 100;
        } else if (v && v.duration) {
          pct = (v.currentTime / v.duration) * 100;
        }
        progressFill.style.width = Math.min(100, pct) + '%';
        progressRAF = requestAnimationFrame(step);
      };
      progressRAF = requestAnimationFrame(step);
    }

    function next() {
      goTo((current + 1) % slides.length);
    }

    function startFallback() {
      if (fallbackTimer) return;
      fallbackStart = performance.now();
      fallbackTimer = setTimeout(next, FALLBACK_DURATION);
    }

    function clearFallback() {
      clearTimeout(fallbackTimer);
      fallbackTimer = null;
    }

    function playCurrent() {
      const v = videoOf(current);
      if (!v) return startFallback();
      ensureVideoLoaded(v);
      const p = v.play();
      if (p && p.catch) p.catch(startFallback);
    }

    function goTo(idx) {
      clearFallback();
      slides[current].classList.remove('active');
      btns[current].classList.remove('active');
      const prev = videoOf(current);
      if (prev) prev.pause();

      current = idx;
      slides[current].classList.add('active');
      btns[current].classList.add('active');
      renderTitle(getWork(slides[current].dataset.id));

      const v = videoOf(current);
      if (v) {
        try { v.currentTime = 0; } catch (e) {}
      }
      progressFill.style.width = '0%';
      if (tabVisible && heroVisible) playCurrent();
    }

    slides.forEach((slide, i) => {
      const v = slide.querySelector('video');
      if (!v) return;
      v.addEventListener('ended', () => {
        if (i === current) next();
      });
      v.addEventListener('error', () => {
        if (i === current) startFallback();
      });
      // Recién cuando el clip actual ya se puede reproducir entero, empieza a
      // bajar el siguiente: así no compiten por la conexión al entrar.
      v.addEventListener('canplaythrough', () => {
        if (i === current) ensureVideoLoaded(videoOf((i + 1) % slides.length));
      });
    });

    btns.forEach((b) => b.addEventListener('click', () => goTo(parseInt(b.dataset.index, 10))));

    if (slideshow) {
      slideshow.addEventListener('click', () => {
        const href = titleLink.getAttribute('href');
        if (href && href !== '#') window.location.href = href;
      });
      slideshow.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          slideshow.click();
        }
      });
    }

    function updatePlayback() {
      if (!started) return;
      const v = videoOf(current);
      if (tabVisible && heroVisible) {
        if (v && v.paused && !fallbackTimer) playCurrent();
      } else if (v) {
        v.pause();
      }
    }

    document.addEventListener('visibilitychange', () => {
      tabVisible = !document.hidden;
      updatePlayback();
    });

    if (hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          heroVisible = entry.isIntersecting;
          updatePlayback();
        },
        { threshold: 0.15 }
      ).observe(hero);
    }

    function startSlideshow() {
      if (started) return;
      started = true;
      renderTitle(getWork(slides[0].dataset.id));
      tickProgress();
      if (tabVisible && heroVisible) playCurrent();
    }

    document.addEventListener('codestudio:intro-done', startSlideshow, { once: true });
    setTimeout(startSlideshow, 2500);
  })();
</script>

<style>
  .hero {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 0.85s var(--ease-out),
      transform 1s var(--ease-out);
  }

  :global(.hero.ready) {
    opacity: 1;
    transform: scale(1);
  }

  .slideshow {
    position: absolute;
    inset: 0;
    z-index: 1;
    cursor: pointer;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  .slide.active { opacity: 1; }

  .slide video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .slideshow::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.28);
    pointer-events: none;
    z-index: 2;
  }

  .bottom {
    position: absolute;
    bottom: 28px;
    left: 0;
    right: 0;
    z-index: 5;
    padding: 0 28px;
  }

  .work-title {
    font-size: clamp(40px, 7vw, 92px);
    line-height: 0.92;
    margin-bottom: 22px;
    max-width: 92%;
    display: block;
    color: var(--milk);
  }

  .work-title :global(.type),
  .work-title :global(.client) {
    display: block;
  }

  .work-title :global(.type) {
    display: inline-block;
    font-family: var(--ff-body);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(10px, 1vw, 13px);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--light);
    margin-bottom: 1.4em;
  }

  .work-title :global(.client) {
    font-family: var(--ff-display);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding-left: 0.5em;
  }

  .work-title :global(.word) {
    display: inline-block;
    white-space: nowrap;
  }

  .work-title :global(.char) {
    display: inline-block;
    opacity: 0;
    transform: translateY(46px);
    filter: blur(12px);
    animation: charIn 0.85s cubic-bezier(0.2, 0.85, 0.2, 1) forwards;
  }

  @keyframes charIn {
    0% { opacity: 0; transform: translateY(46px); filter: blur(12px); }
    60% { filter: blur(0); }
    100% { opacity: 1; transform: translateY(0); filter: blur(0); }
  }

  .progress-bar {
    width: 100%;
    max-width: 460px;
    height: 3px;
    background: rgba(255, 255, 255, 0.22);
    margin-bottom: 14px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    width: 0%;
    background: var(--light);
    will-change: width;
  }

  .bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .slide-nav {
    display: flex;
    gap: 32px;
  }

  .slide-nav button {
    background: none;
    border: none;
    font-family: inherit;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--milk);
    opacity: 0.55;
    cursor: pointer;
    /* Hit area 24x24+ (WCAG tactile targets) */
    min-width: 24px;
    min-height: 24px;
    padding: 4px 6px;
    transition: color 0.2s, opacity 0.2s, font-weight 0.2s;
  }

  .slide-nav button.active {
    color: var(--light);
    font-weight: 700;
    opacity: 1;
  }

  .slide-nav button:hover { opacity: 1; }

  @media (max-width: 820px) {
    .bottom { bottom: 28px; padding: 0 20px; }
    .work-title {
      font-size: clamp(28px, 8.8vw, 52px);
      margin-bottom: 16px;
      line-height: 0.95;
    }
    .work-title :global(.type) {
      font-size: clamp(10px, 2.6vw, 12px);
      letter-spacing: 0.28em;
      margin-bottom: 1.2em;
    }
    .work-title :global(.client) { padding-left: 0.3em; }
    .progress-bar { margin-bottom: 14px; }
    .bottom-row { flex-direction: column; align-items: flex-start; gap: 14px; }
    .slide-nav {
      gap: 22px;
      overflow-x: auto;
      scrollbar-width: none;
      width: 100%;
    }
    .slide-nav::-webkit-scrollbar { display: none; }
    .slide-nav button { font-size: 22px; flex: 0 0 auto; }
  }
</style>
